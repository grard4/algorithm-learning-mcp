                      },
                      "conclusions": {
                        "items": {},
                        "type": "array"
                      },
                      "common_errors": {
                        "items": {},
                        "type": "array"
                      },
                      "evidence": {
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
