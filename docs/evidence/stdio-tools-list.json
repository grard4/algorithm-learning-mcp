                    "additionalProperties": {
                      "items": {},
                      "type": "array"
                    },
                    "description": "向列表追加并去重；evidence 是归档 ID 字符串数组。",
                    "properties": {
                      "taught": {
                        "items": {},
                        "type": "array"
                      },
                      "practiced": {
                        "items": {},
                        "type": "array"
                      },
                      "understood": {
                        "items": {},
                        "type": "array"
                      },
                      "mastered": {
                        "items": {},
                        "type": "array"
                      },
                      "pending": {
                        "items": {},
                        "type": "array"
                      },
                      "completed_exercises": {
                        "items": {},
                        "type": "array"
                      },
                      "pending_exercises": {
                        "items": {},
                        "type": "array"
                      },
                      "conclusions": {
                        "items": {},
                        "type": "array"
                      },
                      "common_errors": {
                        "items": {},
                        "type": "array"
                      },
                      "evidence": {
                        "description": "归档 messages.id 字符串数组；不是对象数组。",
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "remove": {
                    "additionalProperties": {
                      "items": {},
                      "type": "array"
                    },
                    "description": "从列表删除匹配值；不可删空最终 evidence。",
                    "properties": {
                      "taught": {
                        "items": {},
                        "type": "array"
                      },
                      "practiced": {
                        "items": {},
                        "type": "array"
                      },
                      "understood": {
                        "items": {},
                        "type": "array"
                      },
                      "mastered": {
