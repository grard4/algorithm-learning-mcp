  "tools": [
    {
      "name": "search_concept_knowledge",
      "description": "Search approved concept links only; it does not infer or update learning state.",
      "inputSchema": {
        "properties": {
          "concepts": {
            "items": {
              "type": "string"
            },
            "title": "Concepts",
            "type": "array"
          },
          "limit": {
            "default": 2,
            "title": "Limit",
            "type": "integer"
          },
          "topic_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Topic Ids"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "known_versions": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Known Versions"
          }
        },
        "required": [
          "concepts"
        ],
        "title": "search_concept_knowledgeArguments",
        "type": "object"
      }
    },
    {
      "name": "read_concept_link",
